.claude/settings.local.json
**/.claude/settings.local.json
.session-bridge/
.serena/memories/
.serena/cache/
*.bak
test-detect.sh
# .codescout/ holds machine-local cache/logs (usage.db, debug logs, embeddings,
# session state) AND durable project knowledge (memories/, system-prompt.md).
# Ignore the former by default; track the latter so it syncs across machines.
# Root-anchored (leading /) on purpose: a nested .codescout/ (e.g. one left
# behind under a subdirectory from a one-off scoped run) stays fully ignored
# by the general `.codescout/` rule below — only the repo-root instance gets
# the memories/system-prompt exception.
.codescout/
!/.codescout/
/.codescout/*
!/.codescout/memories/
!/.codescout/system-prompt.md
/.codescout/private-memories/
.buddy/
__pycache__/
*.pyc
.fastembed_cache/
.claude/*.log
.claude/codescout-companion.json
.vscode/
.codescout/private-memories/
