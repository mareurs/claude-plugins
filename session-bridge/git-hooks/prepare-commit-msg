#!/usr/bin/env bash
# session-bridge git hook: prepare-commit-msg
#
# Stamp the committing session into the commit as a trailer:
#
#   Session-Id: <token>
#
# Why. Several agent sessions can share one checkout. They commit as the same git author,
# from the same tree, seconds apart, so the author field, commit adjacency and the dirty-file
# list say nothing about who wrote a commit. A trailer names the session in the commit itself.
# The pre-push hook reads it.
#
# Settings: see session-bridge-lib.sh. With no identity (a person at a terminal, a CI job) the
# hook writes nothing. Absence is honest; a guessed owner is not.
#
# `--if-exists doNothing` makes a re-run idempotent, so --amend, rebase and squash never add a
# second trailer, and a replayed commit never gains the replaying session as a second author.
#
# Install: session-bridge/git-hooks/install.sh
# session-bridge-git-hook

set -uo pipefail

msg_file="${1:-}"
[ -n "$msg_file" ] && [ -f "$msg_file" ] || exit 0

_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=session-bridge-lib.sh
. "$_dir/session-bridge-lib.sh" || exit 1

sid="$(sbg_identity)"
rc=$?
if [ "$rc" -ne 0 ]; then
    echo "session-bridge prepare-commit-msg: the identity command failed (exit $rc); no trailer written. Commit refused." >&2
    exit 1
fi
[ -n "$sid" ] || exit 0

# A trailer line that git cannot read. Git reads only the final paragraph of a message as
# trailers. A line written by hand above that paragraph is prose to every query, and the stamp
# below lands beside it. This names the problem and changes nothing: the committing session
# can amend its own message.
raw_n="$(grep -c "^${SBG_TRAILER}:" "$msg_file")"
raw_ids="$(grep "^${SBG_TRAILER}:" "$msg_file" | sed "s/^${SBG_TRAILER}:[[:space:]]*//" | paste -sd, -)"
parsed_n="$(git -c trailer.separators=: interpret-trailers --parse "$msg_file" | grep -c "^${SBG_TRAILER}:")"
if [ "$raw_n" -gt "$parsed_n" ]; then
    echo "session-bridge prepare-commit-msg: this message has $raw_n ${SBG_TRAILER} line(s) ($raw_ids) but only $parsed_n in its final paragraph, the only place git reads trailers from; the rest is invisible to every query. A ${SBG_TRAILER} sits outside its final paragraph, and the push guard cannot see it. This hook is stamping $sid there. Delete the hand-written line (git commit --amend): the hook writes it for you." >&2
fi

# `-c trailer.separators=:` pins the separator, so a user setting cannot change the format.
git -c trailer.separators=: interpret-trailers \
    --in-place \
    --if-exists doNothing \
    --trailer "${SBG_TRAILER}: $sid" \
    "$msg_file"
