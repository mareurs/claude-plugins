+#[test_case::test_case(false; "denied")]
+#[test_case::test_case(true; "approved")]
+#[tokio::test]
+async fn pre_tool_use_native_escalation_retains_host_approval(approve: bool) -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = start_mock_server().await;
+    let scratch = TempDir::new()?;
+    let marker = scratch.path().join("native-approval-marker");
+    let command = format!("printf native-approval > '{}'", marker.display());
+    let call_id = "pretooluse-native-approval";
+    let justification = "May I create the test marker?";
+    let args = json!({
+        "cmd": command,
+        "sandbox_permissions": "require_escalated",
+        "justification": justification,
+        "prefix_rule": ["printf"],
+    });
+    let responses = mount_sse_sequence(
+        &server,
+        vec![
+            sse(vec![
+                ev_response_created("resp-1"),
+                ev_function_call(call_id, "exec_command", &args.to_string()),
+                ev_completed("resp-1"),
+            ]),
+            sse(vec![
+                ev_response_created("resp-2"),
+                ev_assistant_message("msg-1", "approval handled"),
+                ev_completed("resp-2"),
+            ]),
+        ],
+    )
+    .await;
+    let mut builder = test_codex()
+        .with_pre_build_hook(|home| {
+            // Advisory output has no permissionDecision: routing must not grant approval.
+            write_pre_tool_use_hook(home, Some("^Bash$"), "context", "native approval required")
+                .expect("write advisory pre-tool hook");
+        })
+        .with_config(|config| {
+            trust_discovered_hooks(config);
+            config.approvals_reviewer = codex_config::types::ApprovalsReviewer::User;
+        });
+    let test = builder.build(&server).await?;
+    test.codex
+        .start_or_steer_turn(
+            TurnInputRequest::user_input(vec![UserInput::Text {
+                text: "run the native approval command".to_string(),
+                text_elements: Vec::new(),
+            }])
+            .with_thread_settings(ThreadSettingsOverrides {
+                approval_policy: Some(AskForApproval::OnRequest),
+                sandbox_policy: Some(codex_protocol::protocol::SandboxPolicy::ReadOnly {
+                    network_access: false,
+                }),
+                ..Default::default()
+            }),
+        )
+        .await?;
+    let mut approvals = 0;
+    loop {
+        match wait_for_event(&test.codex, |_| true).await {
+            EventMsg::ExecApprovalRequest(approval) => {
+                assert_eq!(approval.call_id, call_id);
+                assert!(!marker.exists(), "command must wait for the host decision");
+                approvals += 1;
+                test.codex
+                    .submit(Op::ExecApproval {
+                        id: approval.effective_approval_id(),
+                        turn_id: Some(approval.turn_id),
+                        decision: if approve {
+                            codex_protocol::protocol::ReviewDecision::Approved
+                        } else {
+                            codex_protocol::protocol::ReviewDecision::denied(
+                                "rejected by test user",
+                            )
+                        },
+                    })
+                    .await?;
+            }
+            EventMsg::TurnComplete(_) => break,
+            _ => {}
+        }
+    }
+    assert_eq!(
+        approvals, 1,
+        "advisory pre-tool hook must retain host approval"
+    );
+    assert_eq!(
+        marker.exists(),
+        approve,
+        "rejected approval must prevent execution"
+    );
+    if approve {
+        assert_eq!(fs::read_to_string(&marker)?, "native-approval");
+    }
+    let inputs = read_pre_tool_use_hook_inputs(test.codex_home_path())?;
+    assert_eq!(inputs.len(), 1);
+    assert_eq!(inputs[0]["tool_name"], "Bash");
+    assert_eq!(
+        inputs[0]["tool_input"],
+        json!({
+            "command": command,
+            "sandbox_permissions": "require_escalated",
+            "justification": justification,
+            "prefix_rule": ["printf"],
+        })
+    );
+    assert_eq!(responses.requests().len(), 2);
+    Ok(())
+}
