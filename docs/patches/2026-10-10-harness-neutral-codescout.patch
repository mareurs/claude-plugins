@@ -0,0 +1,30 @@
+# Harness-neutral session context
+
+Codescout accepts version 1 context: `harness`, opaque root `session_id`, nullable `agent_id`, canonical absolute Git `workspace`, `source`, and nullable `harness_version`. Identity is `<harness>:<session_id>`; a child's thread ID is metadata and keeps its root principal.
+
+`CLAUDE_CODE_SESSION_ID` and `CODEX_SESSION_ID` are native roots. Simultaneous values conflict, even if equal. `CODEX_THREAD_ID` alone is insufficient. Use an absolute `--context` path or `CODESCOUT_CONTEXT_FILE` for explicit context. Conflicting CLI/environment files or disagreement with native identity fail closed. The invocation's Git root is authoritative; an inherited foreign `REPO_ROOT` cannot redirect formatter attribution.
+
+## Modes and outcomes
+
+```sh
+./scripts/gate.sh --check
+./scripts/gate.sh
+./scripts/gate.sh --context /absolute/context.json
+./scripts/gate.sh --exclusive-checkout /absolute/checkout
+```
+
+The same options apply to `fmt-mine.sh`. `--check` bypasses ownership resolution and writes nothing: 0 clean, 1 differences, 2 usage/tool failure. Normal standalone formatting exits cheaply on a clean tree; otherwise context is required. Own and git-clean paths may be formatted; peer/shared/unknown paths are refused with exit 1. Missing/conflicting context or an unsafe target exits 2 without formatting writes.
+
+An exclusive declaration requires an absolute matching Git root and established operator control. It permits formatting there without inventing a MINE label. Conflicting or unsupported context still blocks it. Literal path arguments preserve spaces; ambiguous/unrepresentable paths and symlink/module escapes are rejected before writes. A read-only stdout probe checks clean descendants too; fixed-point formatting remains bounded to three passes.
+
+The gate leases independently of identity and reports all five lanes. A context-blocked formatter has `FMT=2 FMT_STATE=context-blocked`; Python, clippy, lean and default tests still run. Default remains last after earlier failures. Other states are `passed`, `differences`, `ownership-refused`, and `tool-error`. Exit 1 aggregates a completed-lane failure; exit 2 is invalid entry or lease failure. A private snapshot is passed through `CODESCOUT_CONTEXT_FILE` and removed on normal or handled signal exits; SIGKILL cannot execute cleanup. Explicit `CARGO_TARGET_DIR` remains the caller's responsibility.
+
+## Evidence boundaries
+
+`file-provenance.py [--context /absolute/context.json] <literal paths...>` reads Claude and Codex history. `FILE_PROVENANCE_ROOTS` retains the Claude override; `FILE_PROVENANCE_CODEX_ROOTS_JSON` is a JSON array of absolute Codex history roots. Invalid configuration or unreadable/opaque history is an explicit coverage gap. Discovery includes native archived Codex sessions and canonical alias deduplication.
+
+Refused atomic calls do not claim ownership. Non-atomic shell errors or missing results can still represent writes. Root/child event identity and native ordinals govern child/fork replay boundaries. Unknown wrappers and external history bases are not guessed. Shell extraction remains heuristic and manual/editor writes remain uncovered.
+
+Coverage and peer contact are separate capabilities. Known Codex ownership remains known when contact/liveness are unavailable; only Claude owners consult the Claude registry. A not-live marker does not prove abandonment.
+
+Source tests cover both hosts, mixed ownership, same-ID host collisions, child boundaries, refusals, gaps, literal paths, lease concurrency and default-lane continuation. Native capture observations are limited to Claude Code 2.1.296 root hook/Read refusal and Codex 0.160.0 root metadata/opaque exec refusal. Successful write, child, resume, compaction and fork acceptance remains pending because native capture routing did not execute those requested tools. These are observed versions, not a supported version range. The coordinated plugin's capture manifest and smoke procedure record the evidence and deployment blockers.
diff --git a/scripts/claude_history.py b/scripts/claude_history.py
new file mode 100644
index 00000000..0036d3a3
--- /dev/null
+++ b/scripts/claude_history.py
@@ -0,0 +1,145 @@
+"""Decode Claude records and discover every configured profile conservatively."""
+import json
+from pathlib import Path
+import re
+import subprocess
+from typing import Mapping
+
+from provenance_records import CoverageGap, HistoryBatch, Operation, result_refused
+from session_context import principal_key
+
+_NON_ATOMIC = {"Bash", "mcp__codescout__run_command"}
+
+
+def _slug(root: Path) -> str:
+    return re.sub(r"[^A-Za-z0-9]", "-", str(root))
+
+
+def _main_checkout(root: Path) -> Path | None:
+    out = subprocess.run(["git", "-C", str(root), "rev-parse", "--git-common-dir"],
+                         capture_output=True, text=True)
+    if out.returncode:
+        return None
+    common = Path(out.stdout.strip())
+    if not common.is_absolute():
+        common = root / common
+    common = common.resolve()
+    return common.parent if common.name == ".git" and common.parent != root.resolve() else None
+
+
+def _entries(path: Path, root: Path, gaps: list[CoverageGap]) -> list[Path]:
+    try:
+        return sorted(path.iterdir())
+    except FileNotFoundError:
+        return []
+    except OSError:
+        gaps.append(CoverageGap(str(path), "unreadable Claude history directory", root))
+        return []
+
+
+def discover_claude_histories(root: Path, environ: Mapping[str, str]) -> tuple[list[Path], list[CoverageGap]]:
+    gaps = []
+    override = environ.get("FILE_PROVENANCE_ROOTS")
+    if override:
+        directories = [Path(p) for p in re.split(r"[:,]", override) if p]
+    else:
+        home = Path(environ.get("HOME", str(Path.home())))
+        profiles = [p for p in _entries(home, root, gaps)
+                    if p.name == ".claude" or p.name.startswith(".claude-")]
+        custom = environ.get("CLAUDE_CONFIG_DIR")
+        if custom:
+            profiles.append(Path(custom))
+        checkouts = [root.resolve()]
+        main = _main_checkout(root)
+        if main is not None:
+            checkouts.append(main)
+        directories = []
+        for profile in dict.fromkeys(profiles):
+            # Probe the profile explicitly: glob/is_dir may silently swallow unreadability.
+            _entries(profile, root, gaps)
+            directories.extend(profile / "projects" / _slug(checkout) for checkout in checkouts)
+    paths, seen = [], set()
+    for directory in directories:
+        for entry in _entries(directory, root, gaps):
+            candidates = [entry] if entry.suffix == ".jsonl" else [
+                p for p in _entries(entry / "subagents", root, gaps) if p.suffix == ".jsonl"
+            ]
+            for path in candidates:
+                try:
+                    original = path.resolve(strict=True)
+                except OSError:
+                    gaps.append(CoverageGap(str(path), "unreadable Claude history source", root))
+                    continue
+                if original not in seen:
+                    seen.add(original)
+                    paths.append(original)
+    return paths, gaps
+
+
+def _session(path: Path, rec: dict) -> str:
+    fallback = path.parent.parent.name if path.parent.name == "subagents" else path.stem
+    value = rec.get("sessionId") or rec.get("session_id")
+    return value if isinstance(value, str) and value.strip() else fallback
+
+
+def read_claude_history(path: Path) -> HistoryBatch:
+    operations, gaps, calls, results = [], [], [], {}
+    is_child = path.parent.name == "subagents"
+    agent = path.stem.removeprefix("agent-") if is_child else None
+    try:
+        with path.open(encoding="utf-8") as stream:
+            for line_number, line in enumerate(stream, 1):
+                locator = f"{path.resolve()}:{line_number}"
+                try:
+                    rec = json.loads(line)
+                except (ValueError, TypeError):
+                    gaps.append(CoverageGap(locator, "malformed Claude history record", None))
+                    continue
+                if not isinstance(rec, dict):
+                    gaps.append(CoverageGap(locator, "unsupported Claude record", None))
+                    continue
+                content = (rec.get("message") or {}).get("content") if isinstance(rec.get("message"), dict) else None
+                if not isinstance(content, list):
+                    continue
+                cwd = Path(rec["cwd"]) if isinstance(rec.get("cwd"), str) and Path(rec["cwd"]).is_absolute() else None
+                for block_index, block in enumerate(content):
+                    if not isinstance(block, dict):
+                        continue
+                    if block.get("type") == "tool_result" and isinstance(block.get("tool_use_id"), str):
+                        results.setdefault(block["tool_use_id"], []).append(block)
+                    if block.get("type") != "tool_use":
+                        continue
+                    name, inp = block.get("name"), block.get("input")
+                    if not isinstance(name, str) or not isinstance(inp, dict):
+                        gaps.append(CoverageGap(locator, "unsupported Claude tool arguments", cwd))
+                        continue
+                    sid = _session(path, rec)
+                    call = block.get("id") if isinstance(block.get("id"), str) else None
+                    # Producer-scoped event IDs survive copied logs. A line locator is only the
+                    # fallback for old call-less fixtures, never an input-equality heuristic.
+                    event = call or rec.get("uuid")
+                    producer = agent or "root"
+                    source = f"claude-code:{sid}/{producer}/{event}" if isinstance(event, str) else f"{locator}:{block_index}"
+                    timestamp = rec.get("timestamp") if isinstance(rec.get("timestamp"), str) else None
+                    calls.append((source, call, principal_key("claude-code", sid), agent, timestamp, cwd, name, inp))
+    except (OSError, UnicodeError):
+        gaps.append(CoverageGap(str(path), "unreadable Claude history source", None))
+    seen = {}
+    for source, call, principal, agent_id, timestamp, cwd, name, inp in calls:
+        outputs = results.get(call, []) if call else []
+        atomic = name not in _NON_ATOMIC
+        refused = any(result_refused(output) for output in outputs)
+        outcome = ("no-write-refused" if atomic else "partial-error") if refused else (
+            "possible-write" if outputs else "missing-result")
+        if outputs and any(result_refused(output) != result_refused(outputs[0]) for output in outputs[1:]):
+            gaps.append(CoverageGap(source, "conflicting Claude result replay", cwd))
+            outcome = "missing-result"
+        op = Operation(source, call, principal, agent_id, timestamp, cwd, name, inp,
+                       outcome, atomic, is_child, None)
+        previous = seen.get(source)
+        if previous is None:
+            operations.append(op)
+            seen[source] = op
+        elif previous != op:
+            gaps.append(CoverageGap(source, "conflicting Claude call replay", cwd))
+    return HistoryBatch(operations, gaps)
