+            serde_json::json!({"sandbox_permissions": "use_default"}),
+        ),
+        (
+            "additional permissions",
+            serde_json::json!({"sandbox_permissions": "with_additional_permissions"}),
+        ),
+        (
+            "justification only",
+            serde_json::json!({"justification": "May I run it?"}),
+        ),
+        (
+            "prefix only",
+            serde_json::json!({"prefix_rule": ["printf", "%s"]}),
+        ),
+        (
+            "all metadata",
+            serde_json::json!({
+                "sandbox_permissions": "require_escalated",
+                "justification": "May I run it?",
+                "prefix_rule": ["printf"],
+            }),
+        ),
+        (
+            "empty supplied values",
+            serde_json::json!({"justification": "", "prefix_rule": []}),
+        ),
+        (
+            "omitted despite escalation-looking text",
+            serde_json::json!({}),
+        ),
+        (
+            "null metadata",
+            serde_json::json!({
+                "sandbox_permissions": null,
+                "justification": null,
+                "prefix_rule": null,
+            }),
+        ),
+    ] {
+        let mut arguments = supplied.clone();
+        arguments["cmd"] = serde_json::json!(command);
+        let hook_payload = handler
+            .pre_tool_use_payload(&ToolInvocation {
+                session: Arc::clone(&session),
+                step_context: StepContext::for_test(Arc::clone(&turn)),
+                turn: Arc::clone(&turn),
+                cancellation_token: tokio_util::sync::CancellationToken::new(),
+                tracker: Arc::new(Mutex::new(TurnDiffTracker::new())),
+                call_id: "call-native-approval".to_string(),
+                tool_name: codex_tools::ToolName::plain("exec_command"),
+                source: crate::tools::context::ToolCallSource::Direct,
